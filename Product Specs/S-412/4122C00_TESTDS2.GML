        <S412:ThunderstormWarning gml:id="ID2">
            <S412:fixedDateRange>
                <S412:dateStart>
                    <S100:date>2025-10-28</S100:date>
                </S412:dateStart>
                <S412:dateEnd>
                    <S100:date>2025-10-28</S100:date>
                </S412:dateEnd>
                <S412:timeOfDayStart>15:00:00Z</S412:timeOfDayStart>
                <S412:timeOfDayEnd>22:30:00Z</S412:timeOfDayEnd>
            </S412:fixedDateRange>
            <S412:weatherWarningMessage>
                <S412:information>
                    <S412:language>eng</S412:language>
                    <S412:text>Line of severe thunderstorms expected to cross the Port of Montreal reach of the St. Lawrence River between 1500Z and 2230Z 28 October 2025. Wind gusts to 45 knots, frequent cloud to ground lightning, hail and torrential rain reducing visibility.</S412:text>
                </S412:information>
                <S412:information>
                    <S412:language>fra</S412:language>
                    <S412:text>Ligne d orages violents prevue sur le bief du port de Montreal du fleuve Saint-Laurent entre 1500Z et 2230Z le 28 octobre 2025. Rafales jusqu a 45 noeuds, foudre frequente, grele et pluie torrentielle.</S412:text>
                </S412:information>
            </S412:weatherWarningMessage>
            <S412:issueDate>2025-10-28</S412:issueDate>
            <S412:issueTime>11:15:00Z</S412:issueTime>
            <S412:weatherWarningNumber>TSW-2025-1028-014</S412:weatherWarningNumber>
            <S412:cancellationDate>2025-10-28T23:30:00Z</S412:cancellationDate>
            <S412:nextUpdateDateTime>2025-10-28T18:00:00Z</S412:nextUpdateDateTime>
            <S412:dataProviderInformation xlink:arcrole="http://www.iho.int/S-412/gml/1.0.0/roles/componentOf/dataProviderInformation" xlink:href="#ID0"/>
            <S412:geometry>
                <S100:surfaceProperty>
                    <S100:Surface gml:id="SID2" srsName="urn:ogc:def:crs:EPSG::4326">
                        <gml:patches>

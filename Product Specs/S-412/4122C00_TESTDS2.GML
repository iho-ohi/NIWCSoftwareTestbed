        <S412:RestrictedVisibilityWarning gml:id="ID1">
            <S412:fixedDateRange>
                <S412:dateStart>
                    <S100:date>2025-10-27</S100:date>
                </S412:dateStart>
                <S412:dateEnd>
                    <S100:date>2025-10-27</S100:date>
                </S412:dateEnd>
                <S412:timeOfDayStart>03:00:00Z</S412:timeOfDayStart>
                <S412:timeOfDayEnd>13:00:00Z</S412:timeOfDayEnd>
            </S412:fixedDateRange>
            <S412:weatherWarningMessage>
                <S412:information>
                    <S412:language>eng</S412:language>
                    <S412:text>Dense fog over Lac Saint-Louis and the upstream approaches to Ile de Montreal. Visibility reduced to less than one half nautical mile in fog patches from 0300Z until 1300Z 27 October 2025. Mariners are advised to proceed with caution and to sound appropriate fog signals.</S412:text>
                </S412:information>
                <S412:information>
                    <S412:language>fra</S412:language>
                    <S412:text>Brouillard dense sur le lac Saint-Louis et les approches amont de l ile de Montreal. Visibilite reduite a moins d un demi mille marin dans les bancs de brouillard de 0300Z a 1300Z le 27 octobre 2025.</S412:text>
                </S412:information>
            </S412:weatherWarningMessage>
            <S412:issueDate>2025-10-26</S412:issueDate>
            <S412:issueTime>21:30:00Z</S412:issueTime>
            <S412:weatherWarningNumber>RVW-2025-1027-001</S412:weatherWarningNumber>
            <S412:cancellationDate>2025-10-27T14:00:00Z</S412:cancellationDate>
            <S412:nextUpdateDateTime>2025-10-27T09:00:00Z</S412:nextUpdateDateTime>
